exports{
    @r func page: text {
        return "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Awl Board</title>\n<style>\n:root{color-scheme:light;font:15px/1.5 system-ui,-apple-system,sans-serif;color:#25312c;background:#f5f6f2;--green:#245c47;--line:#dfe4dc}*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button{cursor:pointer;border:1px solid var(--line);border-radius:8px;background:white;padding:9px 14px;color:inherit}button:hover{background:#edf1e9}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #73a797;outline-offset:3px}.primary{background:var(--green);color:white;border-color:var(--green)}.primary:hover{background:#174936}.shell{max-width:1320px;margin:auto;padding:32px 40px}header{display:flex;align-items:center;gap:14px;padding-bottom:28px;border-bottom:1px solid var(--line)}.logo{display:grid;place-items:center;background:#000;border-radius:12px;width:46px;height:46px;flex-shrink:0}.logo svg{width:32px;height:33px}.brand{font-weight:750;font-size:18px;letter-spacing:-.5px}.subtle{color:#758075;font-size:12px}.header-end{margin-left:auto;display:flex;gap:10px;align-items:center}.dot{width:7px;height:7px;background:#398768;border-radius:50%;display:inline-block;margin-right:7px}h1{font-size:34px;letter-spacing:-1.2px;line-height:1.15;margin:0 0 10px}p{margin:0}.intro{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:42px 0 30px}.eyebrow{text-transform:uppercase;letter-spacing:1.9px;font-size:10px;font-weight:750;color:var(--green);margin-bottom:10px}.description{color:#758075;max-width:650px}.toolbar{display:flex;align-items:center;gap:12px;margin-bottom:24px}.search{position:relative;flex:1;max-width:460px}.search input{padding-left:38px;width:100%}.search span{position:absolute;left:14px;top:10px;color:#758075}input,textarea,select{border:1px solid var(--line);background:#fff;color:inherit;border-radius:8px;padding:10px 12px}select{max-width:180px}#summary{margin-left:auto;color:#758075;font-size:12px}.board{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.column{background:#ecefe8;border:1px solid #e3e8df;border-radius:12px;padding:16px;min-height:390px}.col-head{display:flex;gap:8px;align-items:center;font-size:12px;font-weight:700;margin:0 0 16px}.col-head:before{content:'';width:7px;height:7px;border-radius:50%;background:#b4beb1}.column[data-status=doing] .col-head:before{background:#b78b44}.column[data-status=done] .col-head:before{background:#398768}.count{font-size:10px;border:1px solid #d6dfd1;border-radius:5px;padding:0 5px;color:#6a7667}.add{margin-left:auto;padding:0 5px;background:transparent;border:0;font-size:20px;line-height:1}.card{padding:18px;background:white;border:1px solid #dde4d8;border-radius:9px;box-shadow:0 2px 3px #25312c04;margin-bottom:12px;overflow-wrap:anywhere}.card-top{display:flex;gap:10px;align-items:center;justify-content:space-between}.task-id{font-size:10px;color:#8a9586;letter-spacing:.6px}.edit{font-size:11px;padding:2px 7px;border:0;color:#687862}.card h3{font-size:14px;font-weight:650;margin:9px 0 7px;line-height:1.4}.note{font-size:12px;color:#7b8576;white-space:pre-wrap;margin-bottom:18px}.card-foot{display:flex;align-items:center;gap:10px;justify-content:space-between;border-top:1px solid #edf0e9;padding-top:12px}.card-foot select{font-size:10px;padding:4px 8px;background:#f7f8f5;max-width:135px}.mini-label{font-size:9px;color:#a0aa9b;text-transform:uppercase;letter-spacing:1px}.empty{border:1px dashed #cbd6c6;border-radius:8px;padding:28px 10px;text-align:center;color:#8a9786;font-size:12px}.banner{margin-bottom:20px;padding:12px 16px;border:1px solid #e4c99d;background:#fff7e8;border-radius:8px;color:#70542b;font-size:13px}.banner[hidden]{display:none}.banner button{margin-left:8px;padding:3px 8px;font-size:11px}footer{display:flex;justify-content:space-between;gap:15px;color:#87917f;font-size:10px;padding:25px 0}.engine{border:1px solid var(--line);padding:4px 8px;border-radius:5px;background:#f9faf7}dialog{border:1px solid var(--line);border-radius:14px;padding:28px;width:min(500px,calc(100vw - 32px));box-shadow:0 15px 80px #1e3c2c30}dialog::backdrop{background:#12251b55}dialog h2{margin:0 0 22px;font-size:23px;letter-spacing:-.5px}label{display:block;font-size:12px;font-weight:650;margin:15px 0 7px}dialog input,dialog textarea,dialog select{width:100%;max-width:none}textarea{resize:vertical;min-height:100px}.hint{font-size:10px;color:#87917f;margin-top:4px}.actions{display:flex;gap:10px;justify-content:flex-end;margin-top:24px}.danger{color:#9d3f32;margin-right:auto}.form-error{font-size:12px;color:#9d3f32;min-height:18px;margin-top:14px}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:760px){.shell{padding:20px}.board{grid-template-columns:1fr}.column{min-height:180px}.intro{align-items:flex-start;padding:30px 0 24px}h1{font-size:28px}.description{font-size:12px}.toolbar{flex-wrap:wrap}.search{max-width:none;min-width:180px}#summary{width:100%;margin:0}.header-end .subtle{display:none}footer{flex-wrap:wrap}.intro .primary{white-space:nowrap}.brand{font-size:16px}}\n</style>\n<div class=\"shell\"><header><div class=\"logo\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 524\" width=\"512\" height=\"524\">\n  <title>Owl</title>\n\n  <defs>\n    <mask id=\"owl-mask\">\n      <rect width=\"512\" height=\"524\" fill=\"white\"/>\n\n      <g fill=\"none\" stroke=\"black\" stroke-width=\"12\"\n         stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M105 169 C160 250 125 421 29 511\"\n              transform=\"rotate(-20 105 330)\"/>\n        <path d=\"M407 169 C352 250 387 421 483 511\"\n              transform=\"rotate(20 407 330)\"/>\n      </g>\n    </mask>\n  </defs>\n\n  <g transform=\"translate(0 12)\">\n    <path fill=\"#fff\" fill-rule=\"evenodd\" mask=\"url(#owl-mask)\" d=\"\n      M90 24\n      C160 104 352 104 422 24\n      C428 80 432 150 424 210\n      C446 290 448 400 380 450\n      Q256 474 132 450\n      C64 400 66 290 88 210\n      C80 150 84 80 90 24 Z\n\n      M136 172 a52 52 0 1 0 104 0 a52 52 0 1 0 -104 0 Z\n      M272 172 a52 52 0 1 0 104 0 a52 52 0 1 0 -104 0 Z\n\n      M256 190 L268 208 L256 230 L244 208 Z\n    \"/>\n\n    <circle cx=\"188\" cy=\"174\" r=\"24\" fill=\"#fff\"/>\n    <circle cx=\"324\" cy=\"174\" r=\"24\" fill=\"#fff\"/>\n  </g>\n</svg>\n</div><div><div class=\"brand\">Awl Board</div><div class=\"subtle\">a little space to move things forward</div></div><div class=\"header-end\"><span class=\"subtle\"><span class=\"dot\"></span>local &amp; persistent</span><button id=\"export\" disabled>export JSON</button></div></header>\n<main><section class=\"intro\"><div><div class=\"eyebrow\">your local workspace</div><h1>Make room for progress</h1><p class=\"description\">Keep the next thing clear, from a first idea to a finished task</p></div><button class=\"primary\" id=\"new\" disabled>＋ new task</button></section>\n<div id=\"banner\" class=\"banner\" role=\"status\" hidden><span id=\"message\"></span><button id=\"refresh\">refresh board</button></div>\n<div class=\"toolbar\"><div class=\"search\"><span aria-hidden=\"true\">⌕</span><label class=\"sr\" for=\"search\">search titles and notes</label><input id=\"search\" placeholder=\"Search your tasks…\" maxlength=\"160\" autocomplete=\"off\"></div><label class=\"sr\" for=\"filter\">filter by status</label><select id=\"filter\"><option value=\"all\">all statuses</option><option value=\"todo\">to do</option><option value=\"doing\">in progress</option><option value=\"done\">done</option></select><span id=\"summary\" aria-live=\"polite\">connecting to your board</span></div>\n<div class=\"board\" id=\"board\"><section class=\"column\" data-status=\"todo\"><h2 class=\"col-head\">To do <span class=\"count\">0</span><button class=\"add\" aria-label=\"add to do task\" data-add=\"todo\" disabled>＋</button></h2><div class=\"cards\"></div></section><section class=\"column\" data-status=\"doing\"><h2 class=\"col-head\">In progress <span class=\"count\">0</span><button class=\"add\" aria-label=\"add in progress task\" data-add=\"doing\" disabled>＋</button></h2><div class=\"cards\"></div></section><section class=\"column\" data-status=\"done\"><h2 class=\"col-head\">Done <span class=\"count\">0</span><button class=\"add\" aria-label=\"add done task\" data-add=\"done\" disabled>＋</button></h2><div class=\"cards\"></div></section></div></main>\n<footer><span id=\"revision\">not connected</span><span class=\"engine\" id=\"engine\">native Awl storage · Awl / WebAssembly filtering</span><span>32 tasks · one local writer · no cloud</span></footer></div>\n<dialog id=\"editor\"><form id=\"form\"><h2 id=\"dialog-title\">A new task</h2><label for=\"title\">Title</label><input id=\"title\" required maxlength=\"160\" autocomplete=\"off\"><div class=\"hint\" id=\"title-count\">0 / 160 UTF-8 bytes</div><label for=\"note\">Notes</label><textarea id=\"note\" maxlength=\"256\" placeholder=\"A little context, a useful next step…\"></textarea><div class=\"hint\" id=\"note-count\">0 / 256 UTF-8 bytes</div><label for=\"status\">Status</label><select id=\"status\"><option value=\"todo\">to do</option><option value=\"doing\">in progress</option><option value=\"done\">done</option></select><div class=\"form-error\" id=\"form-error\" role=\"alert\"></div><div class=\"actions\"><button type=\"button\" id=\"delete\" class=\"danger\" hidden>delete task</button><button type=\"button\" id=\"cancel\">cancel</button><button class=\"primary\" id=\"save\">save task</button></div></form></dialog>\n<script>\n'use strict';\nconst $=id=>document.getElementById(id),encoder=new TextEncoder(),labels={todo:'to do',doing:'in progress',done:'done'};\nconst packed='',runtime=\"'use strict';\\nasync function runAwl(bytes,args){\\n const encoder=new TextEncoder(),decoder=new TextDecoder('utf-8',{fatal:true});\\n if(!Array.isArray(args)||args.some(s=>typeof s!=='string'||s.includes('\\\\0')||/[\\\\uD800-\\\\uDFFF]/u.test(s)))throw Error('arguments must be valid unicode strings without NUL');\\n const argv=['Awl',...args].map(s=>encoder.encode(s)),total=argv.reduce((n,b)=>n+b.length+1,0);\\n if(total>65536||argv.length>256)throw Error('argument limit');\\n const mod=await WebAssembly.compile(bytes);let instance,code=0,written=0;const chunks=[[],[]],exit={};\\n const memory=()=>instance.exports.memory;\\n const range=(p,n)=>{p>>>=0;n>>>=0;if(p>memory().buffer.byteLength||n>memory().buffer.byteLength-p)throw Error('guest memory range');return p};\\n const view=()=>new DataView(memory().buffer);\\n const set32=(p,n)=>view().setUint32(range(p,4),n,true);\\n const wasi={\\n  args_sizes_get:(n,size)=>{set32(n,argv.length);set32(size,total);return 0},\\n  args_get:(p,buf)=>{range(p,argv.length*4);range(buf,total);for(const arg of argv){set32(p,buf);p+=4;new Uint8Array(memory().buffer,buf,arg.length).set(arg);buf+=arg.length;new Uint8Array(memory().buffer)[buf++]=0}return 0},\\n  fd_fdstat_get:(fd,p)=>{if(fd!==1&&fd!==2)return 8;range(p,24);new Uint8Array(memory().buffer,p,24).fill(0);view().setUint8(p,2);view().setBigUint64(p+8,64n,true);return 0},\\n  fd_write:(fd,p,n,out)=>{if(fd!==1&&fd!==2)return 8;n>>>=0;if(n>1024)return 28;range(out,4);range(p,n*8);let count=0;const parts=[];for(let i=0;i<n;i++){const a=view().getUint32(p+i*8,true),b=view().getUint32(p+i*8+4,true);range(a,b);count+=b;if(written+count>1048576)throw Error('output limit');parts.push(new Uint8Array(memory().buffer,a,b).slice())}written+=count;chunks[fd-1].push(...parts);set32(out,count);return 0},\\n  fd_seek:fd=>(fd===1||fd===2)?70:8,\\n  fd_close:()=>8,\\n  proc_exit:n=>{code=n>>>0;throw exit}\\n };\\n for(const item of WebAssembly.Module.imports(mod))if(item.module!=='wasi_snapshot_preview1'||item.kind!=='function'||!Object.hasOwn(wasi,item.name))throw Error('unsupported import '+item.module+'.'+item.name);\\n instance=await WebAssembly.instantiate(mod,{wasi_snapshot_preview1:wasi});\\n if(!(instance.exports.memory instanceof WebAssembly.Memory)||typeof instance.exports._start!=='function')throw Error('command ABI required');\\n try{instance.exports._start()}catch(e){if(e!==exit)throw e}\\n const text=parts=>{const size=parts.reduce((n,p)=>n+p.length,0),all=new Uint8Array(size);let i=0;for(const p of parts){all.set(p,i);i+=p.length}return decoder.decode(all)};\\n return {code,stdout:text(chunks[0]),stderr:text(chunks[1]),memoryBytes:memory().buffer.byteLength};\\n}\\nif(typeof module!=='undefined')module.exports={runAwl};\\n\";\nlet state=null,etag='',busy=false,blocked=false,editing=null,draftTag='',worker=null,workerTimer=null,request=0,debounce=null,lastIds=[],engineReady=false;\nlet binaryPromise;\nfunction wasmBytes(){return binaryPromise??=new Response(new Blob([Uint8Array.from(atob(packed),c=>c.charCodeAt(0))]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer()}\nfunction banner(message,refresh=true){$('banner').hidden=!message;$('message').textContent=message;$('refresh').hidden=!refresh}\nfunction controls(){document.querySelectorAll('#new,[data-add],.edit,.move').forEach(b=>b.disabled=busy||blocked||!state||!engineReady);$('export').disabled=!state||busy;$('save').disabled=busy||blocked;$('delete').disabled=busy||blocked;$('cancel').disabled=busy}\nfunction node(tag,cls,text){const el=document.createElement(tag);if(cls)el.className=cls;if(text!==undefined)el.textContent=text;return el}\nfunction paint(ids){lastIds=ids;for(const column of document.querySelectorAll('.column')){const status=column.dataset.status,tasks=state.tasks.filter(t=>t.status===status&&ids.includes(t.id)),area=column.querySelector('.cards');area.replaceChildren();column.querySelector('.count').textContent=tasks.length;for(const task of tasks){const card=node('article','card');card.dataset.id=task.id;const top=node('div','card-top');top.append(node('span','task-id',`TASK \${String(task.id).padStart(3,'0')}`));const edit=node('button','edit','edit');edit.setAttribute('aria-label',`edit \${task.title}`);edit.onclick=()=>open(task);top.append(edit);card.append(top,node('h3','',task.title),node('p','note',task.note||'No notes yet'));const foot=node('div','card-foot'),select=node('select','move');select.setAttribute('aria-label',`status for \${task.title}`);for(const [value,label] of Object.entries(labels)){const option=node('option','',label);option.value=value;select.append(option)}select.value=task.status;select.onchange=()=>move(task,select.value);foot.append(select,node('span','mini-label','local task'));card.append(foot);area.append(card)}if(!tasks.length)area.append(node('div','empty',state.tasks.length?'Nothing here for this view':'A clear space for your next step'))}const total=state.tasks.length,done=state.tasks.filter(t=>t.status==='done').length;$('summary').textContent=`\${ids.length} of \${total} tasks · \${done} done`;$('revision').textContent=`snapshot v\${state.revision} · saved on this machine`;controls()}\nfunction stopWorker(){if(worker)worker.terminate();worker=null;clearTimeout(workerTimer);workerTimer=null}\nasync function filterBoard(){if(!state)return;const id=++request;stopWorker();engineReady=false;controls();try{const query=$('search').value;if(encoder.encode(query).length>160)throw Error('search is limited to 160 UTF-8 bytes');const bytes=await wasmBytes();if(id!==request)return;const source=runtime+'\\nself.onmessage=async e=>{try{postMessage({result:await runAwl(e.data.bytes,e.data.args)})}catch(e){postMessage({error:String(e.message||e)})}}';const url=URL.createObjectURL(new Blob([source],{type:'text/javascript'}));worker=new Worker(url);URL.revokeObjectURL(url);workerTimer=setTimeout(()=>fail('Awl filtering timed out, change the search to retry'),5000);function fail(message){if(id!==request)return;stopWorker();engineReady=false;$('engine').textContent='filter unavailable';banner(message);controls()}worker.onerror=e=>fail(e.message||'worker failed');worker.onmessage=e=>{if(id!==request)return;stopWorker();const r=e.data.result;if(e.data.error||!r||r.code!==0)return fail(e.data.error||`filter rejected state (\${r?.code})`);const ids=r.stdout.trim()?r.stdout.trim().split('\\n').map(Number):[];if(ids.some(id=>!Number.isInteger(id)||!state.tasks.some(t=>t.id===id)))return fail('invalid filter response');engineReady=true;$('engine').textContent='native Awl storage · Awl / WebAssembly filtering';paint(ids);globalThis.AwlBoard.lastFilter={ids,code:r.code,memoryBytes:r.memoryBytes}};worker.postMessage({bytes,args:[JSON.stringify(state),query,$('filter').value]})}catch(e){stopWorker();banner(e.message);controls()}}\nasync function fetchDeadline(url,options={}){return fetch(url,{...options,signal:AbortSignal.timeout(5000)})}\nasync function refresh(){if(busy)return;busy=true;controls();try{const res=await fetchDeadline('/api/tasks');if(!res.ok)throw Error(`load failed (\${res.status})`);state=await res.json();etag=res.headers.get('ETag');if(!etag)throw Error('missing snapshot version');blocked=false;banner('');await filterBoard()}catch(e){banner(`Could not load the board, \${e.message}, start the server and refresh`)}finally{busy=false;controls()}}\nfunction counts(){for(const [id,max] of [['title',160],['note',256]])$(id+'-count').textContent=`\${encoder.encode($(id).value).length} / \${max} UTF-8 bytes`}\nfunction open(task=null,status='todo'){if(busy||blocked||!state)return;editing=task;draftTag=etag;$('dialog-title').textContent=task?'Edit your task':'A new task';$('title').value=task?.title||'';$('note').value=task?.note||'';$('status').value=task?.status||status;$('delete').hidden=!task;$('form-error').textContent='';counts();$('editor').showModal();$('title').focus()}\nasync function mutate(id,data,tag,modal=false){if(busy||blocked)return false;busy=true;controls();try{const res=await fetchDeadline('/api/tasks/'+id,{method:data?'PUT':'DELETE',headers:{'Content-Type':'application/json','If-Match':tag},body:data?JSON.stringify(data):undefined});if(!res.ok){if(res.status===412)throw Error('another tab changed the board, keep this draft, cancel and refresh before trying again');if(res.status===507)throw Error('board capacity reached, export and start a new board or remove a task');if(res.status===422)throw Error('invalid task, check the UTF-8 byte limits and title');if(res.status===503)throw Error('storage unavailable, nothing was published, your draft is still here');throw Error(`save failed (\${res.status})`)}state=await res.json();etag=res.headers.get('ETag');blocked=res.status===202||res.headers.get('X-Awl-Durability')==='uncertain';banner(blocked?'The snapshot was published but durability is uncertain, the server stopped safely, restart and refresh before editing again':'',blocked);if(modal)$('editor').close();await filterBoard();return true}catch(e){const msg=['TimeoutError','TypeError','SyntaxError'].includes(e.name)?'the result is unknown, keep this draft, cancel and refresh before retrying':e.message;if(modal)$('form-error').textContent=msg;else banner(msg);return false}finally{busy=false;controls()}}\nasync function move(task,status){await mutate(task.id,{title:task.title,note:task.note,status},etag);if(state)paint(lastIds)}\n$('form').onsubmit=async e=>{e.preventDefault();if(encoder.encode($('title').value).length>160||encoder.encode($('note').value).length>256){$('form-error').textContent='please shorten the text to fit the UTF-8 byte limits';return}await mutate(editing?.id??state.next_id,{title:$('title').value,note:$('note').value,status:$('status').value},draftTag,true)};\n$('delete').onclick=()=>{if(confirm('Delete this task? This cannot be undone.'))mutate(editing.id,null,draftTag,true)};\n$('new').onclick=()=>open();document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>open(null,b.dataset.add));$('cancel').onclick=()=>$('editor').close();$('editor').addEventListener('cancel',e=>{if(busy)e.preventDefault()});$('title').oninput=counts;$('note').oninput=counts;$('refresh').onclick=refresh;$('search').oninput=()=>{clearTimeout(debounce);debounce=setTimeout(filterBoard,120)};$('filter').onchange=filterBoard;\n$('export').onclick=async()=>{try{const res=await fetchDeadline('/api/export');if(!res.ok)throw Error('export failed');const url=URL.createObjectURL(await res.blob()),a=document.createElement('a');a.href=url;a.download='awl-board.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}catch(e){banner(e.message)}};\nglobalThis.AwlBoard={refresh,filterBoard,get state(){return state},get ready(){return engineReady},lastFilter:null};\nrefresh();\n</script></html>\n";
    };
};
